<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AIRsLight.ClashOfRim</AssemblyName>
    <RootNamespace>AIRsLight.ClashOfRim</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Import Project="../../Tools/RimWorld.Client.props" />

  <ItemGroup>
    <ProjectReference Include="..\Shared\ClashOfRim.Compatibility\ClashOfRim.Compatibility.csproj" />
    <ProjectReference Include="..\Shared\ClashOfRim.Protocol\ClashOfRim.Protocol.csproj" />
  </ItemGroup>
</Project>
